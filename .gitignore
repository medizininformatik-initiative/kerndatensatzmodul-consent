# --- IG Publisher / SUSHI build artifacts (regenerated on every build) ---
# The generated IG website. Never commit it; previews are published via CI.
output/
# IG Publisher scratch space.
temp/
# The template package the IG Publisher extracts into ./template at build
# time. Why: this repo REFERENCES the template in ig.ini (repository URL today,
# package pin once published); the extracted copy is a build artifact. (The
# deliberate vendored fallback copy lives under a different, tracked path:
# ig-template/.)
template/
# Downloaded FHIR package cache.
input-cache/
# FSH -> FHIR JSON output generated by SUSHI.
fsh-generated/
# The IG Publisher jar itself — downloaded, version-pinned, never committed.
publisher.jar

# --- Tooling ---
node_modules/

# --- OS / editor noise ---
.DS_Store
*.log

# ── Migration additions ──────────────────────────────────────────────────────
# Firely-era lockfile ignore carried from the source repository (retire at
# Gate D per migration decision D-13):
fhirpkg.lock.json
# The migration run-log evidence is COMMITTED — exempt it from the blanket
# *.log rule above (mii-ig-migration doctrine; without this the run log
# silently never reaches the branch):
!migration-log/
!migration-log/*.log
